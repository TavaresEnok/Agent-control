# Build context is produced by prepare-native-execution-image.mjs, never a home directory.
# glibc base: the Claude CLI is a dynamic glibc ELF and does not run on the Alpine Node image.
FROM node@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
COPY native-execution-worker.mjs /opt/agent-control/dist/src/native-execution-worker.mjs
COPY --chmod=0555 codex /usr/local/bin/codex
# Optional claude/grok binaries (AC_NATIVE_CLAUDE_BIN, AC_NATIVE_GROK_BIN). The directory may be empty.
COPY --chmod=0555 extra-bin/ /usr/local/bin/
COPY --chmod=0755 ac-exam-claude.cjs /usr/local/bin/ac-exam-claude
# Every non-exam Claude run goes through one of these: no project or account hook, no project MCP server.
COPY --chmod=0755 ac-claude-evaluator.cjs /usr/local/bin/ac-claude-evaluator
COPY --chmod=0755 ac-claude-programmer.cjs /usr/local/bin/ac-claude-programmer
# System CA bundle: the Codex CLI verifies TLS against it (Claude and Grok ship their own).
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates >/dev/null && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /account /input /output /planning /runner && chmod 0555 /runner
USER node
WORKDIR /planning
ENTRYPOINT ["node", "/opt/agent-control/dist/src/native-execution-worker.mjs"]

{
  "name": "agent-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-ci.mjs",
    "test:all": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:isolated": "node scripts/test-isolated.mjs",
    "start": "node --import tsx src/lab-main.ts",
    "start:built": "node dist/src/lab-main.js",
    "gateway": "node --import tsx src/server-main.ts",
    "personal:setup": "node scripts/personal-setup.mjs",
    "personal:images": "node scripts/personal-images.mjs",
    "personal:project": "node scripts/personal-project.mjs",
    "personal:qa": "node scripts/personal-qa.mjs",
    "personal:combo": "node scripts/personal-combo.mjs",
    "personal:roots": "node scripts/personal-roots.mjs",
    "personal:happier": "node scripts/personal-happier.mjs",
    "personal:services": "node scripts/personal-services.mjs",
    "personal:public": "node scripts/personal-public.mjs",
    "prebuild": "node scripts/prepare-build.mjs --before",
    "personal:cockpit": "node scripts/personal-cockpit.mjs",
    "personal:backup": "node scripts/personal-backup.mjs",
    "personal:backup-rotate": "node scripts/personal-backup-rotate.mjs",
    "personal:restore-check": "node scripts/personal-restore-check.mjs",
    "personal:watch": "node scripts/personal-watch.mjs",
    "personal:timers": "node scripts/personal-timers.mjs",
    "personal:maintenance": "node scripts/personal-maintenance.mjs",
    "personal:restore-proof": "node scripts/personal-restore-proof.mjs",
    "personal:design": "node scripts/personal-design.mjs",
    "personal:verify": "node scripts/personal-verify.mjs",
    "personal:arquitetura": "node scripts/personal-arquitetura.mjs",
    "personal:dependencias": "node scripts/personal-dependencias.mjs",
    "personal:banco": "node scripts/personal-banco.mjs",
    "personal:prontidao": "node scripts/personal-prontidao.mjs",
    "personal:desempenho": "node scripts/personal-desempenho.mjs",
    "personal:documentacao": "node scripts/personal-documentacao.mjs",
    "personal:conformidade": "node scripts/personal-conformidade.mjs",
    "personal:mapa": "node scripts/personal-mapa.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "hono": "4.12.0",
    "parse5": "7.3.0",
    "pg": "8.16.3",
    "socket.io-client": "4.8.3",
    "tweetnacl": "1.0.3",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
    "@types/web-push": "3.6.4",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "deploy/modules/conformidade"
  ]
}

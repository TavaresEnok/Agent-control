+ return <div data-slo-panel="report" data-slo-layout={narrow?'stack':'wide'} className="flex min-w-0 flex-col gap-2">
+  <p className="break-words text-xs text-muted-foreground">Catálogo {report.catalogVersion}, agregado da central, janela pontual. Desconhecido não é cumprimento do objetivo.</p>
+  <div className="grid min-w-0 grid-cols-1 gap-2">
+   {SLO_ORDER.map(id=>{
+    const result=byId.get(id)
+    if(!result)return null
+    const violated=result.status==='violated'
+    return <article key={id} data-slo={id} className={`min-w-0 break-words rounded-md border p-3 text-sm ${violated?'border-2 border-destructive bg-destructive/10':'border-border'}`}>
+     <h3 className="font-medium">{SLO_LABEL[id]}</h3>
+     <p><span className="text-muted-foreground">Estado: </span><strong data-slo-status={result.status}>{STATUS_LABEL[result.status]}</strong></p>
+     {violated&&<p role="alert">Objetivo violado. O destaque não depende só da cor.</p>}
+     {result.status==='unknown'&&<p role="status">Desconhecido não é cumprimento do objetivo.</p>}
+     <p>Motivo: {reasonText(result.status,result.reason)}</p>
+     <p>Margem: {formatMargin(result.margin)}</p>
+     <p>Janela: {formatWindow(result.window)}</p>
+    </article>
+   })}
+  </div>
+ </div>
+}
+export function AgentControlObservability({enabled}:{enabled:boolean}){
+ const {projectId}=useProjectScope()
+ const narrow=useNarrowSloLayout()
+ const observed=useQuery({queryKey:['ac-operational-observability',projectId],enabled,refetchInterval:15000,queryFn:async()=>{
+  const response=await agentControlFetch('/api/v1/ac/observability')
+  if(!response.ok)throw Error(`Métricas indisponíveis (HTTP ${response.status}).`)
+  return agentControlOperationalSnapshotSchema.parse(await response.json())
+ }})
+ const sloEnabled=enabled&&projectId!==null
+ const slo=useQuery({queryKey:['ac-operational-slo',projectId],enabled:sloEnabled,retry:false,refetchInterval:15000,queryFn:async()=>{
+  let response:Response
+  try{response=await agentControlFetch('/api/v1/ac/observability/slo')}catch{throw Error(sloUnavailableMessage)}
+  if(!response.ok)throw Error(sloUnavailableMessage)
+  let body:unknown
+  try{body=await response.json()}catch{throw Error(sloUnavailableMessage)}
+  const parsed=agentControlSloReportSchema.safeParse(body)
+  if(!parsed.success)throw Error(sloUnavailableMessage)
+  return parsed.data
+ }})
+ if(!enabled)return null
+ const retryClass=narrow?'min-h-11 h-auto w-full whitespace-normal':'min-h-11 h-auto whitespace-normal'
+ return <>
+  <SettingsField title="Operação da central" hint="Leitura de estados confirmados no PostgreSQL e medições de disco configuradas. Somente administradores podem consultar este agregado.">
+   <Button type="button" variant="outline" disabled={observed.isFetching} onClick={()=>{void observed.refetch()}}>Atualizar métricas</Button>
+   {observed.isPending&&<p role="status">Carregando métricas…</p>}{observed.error&&<p role="alert">{observed.error.message}</p>}
+   {observed.data&&<OperationalReadout data={observed.data}/>}
+  </SettingsField>
+  <SettingsField title="Níveis de serviço" hint="Leitura do catálogo versionado no agregado da central. Somente administradores podem consultar. Um estado desconhecido não cumpre o objetivo.">
+   {sloEnabled&&!slo.isError&&<Button type="button" variant="outline" className={retryClass} disabled={slo.isFetching} onClick={()=>{void slo.refetch()}}>Atualizar níveis de serviço</Button>}
+   {slo.isLoading&&<p role="status">Carregando níveis de serviço…</p>}
+   {enabled&&!sloEnabled&&<p role="status">{sloUnavailableMessage}</p>}
+   {slo.isError&&<div role="alert" data-slo-panel="unavailable" className="flex min-w-0 flex-col gap-2 break-words">
+    <p>{sloUnavailableMessage}</p>
+    <Button type="button" variant="outline" className={retryClass} disabled={slo.isFetching} onClick={()=>{void slo.refetch()}}>Tentar novamente</Button>
+   </div>}
+   {slo.isSuccess&&slo.data&&<SloReadout report={slo.data} narrow={narrow}/>}
+  </SettingsField>
+ </>
+}
diff --git a/packages/web/src/routes/settings/agent-control-operator.ts b/packages/web/src/routes/settings/agent-control-operator.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9cfe19fdc828d7b67b05bd27b736f71d18fe5616
--- /dev/null
+++ b/packages/web/src/routes/settings/agent-control-operator.ts
@@ -0,0 +1,52 @@
+/** A device signing key stays non-extractable in browser storage. It is never a provider credential. */
+type Device={id:string;privateKey:CryptoKey;publicKey:string}
+function canonical(value:unknown):string{
+ if(Array.isArray(value))return '['+value.map(canonical).join(',')+']'
+ if(value!==null&&typeof value==='object')return '{'+Object.entries(value).sort(([a],[b])=>a.localeCompare(b)).map(([k,v])=>JSON.stringify(k)+':'+canonical(v)).join(',')+'}'
+ const text=JSON.stringify(value);if(text===undefined)throw Error('INVALID_SIGNED_COMMAND');return text
+}
+function storedDevice(raw:unknown):Device{
+ const value=raw as Device|undefined
+ if(!value||typeof value.id!=='string'||typeof value.publicKey!=='string'||!(value.privateKey instanceof CryptoKey)||
+  value.privateKey.type!=='private'||value.privateKey.extractable||value.privateKey.algorithm.name!=='Ed25519'||!value.privateKey.usages.includes('sign'))throw Error('DEVICE_KEY_INVALID')
+ return value
+}
+const pending=new Map<string,Promise<Device>>()
+async function device(principal:string,legacyIds:readonly string[]=[]):Promise<Device>{
+ if(!principal)throw Error('PRINCIPAL_REQUIRED')
+ const current=pending.get(principal);if(current)return current
+ const scope='principal:'+principal
+ const promise=(async()=>{
+  if(!crypto.subtle)throw Error('SECURE_BROWSER_REQUIRED')
+  const db=await new Promise<IDBDatabase>((ok,fail)=>{const req=indexedDB.open('agent-control-operator',1)
+   req.onupgradeneeded=()=>req.result.createObjectStore('keys');req.onerror=()=>fail(Error('DEVICE_STORAGE_UNAVAILABLE'));req.onsuccess=()=>ok(req.result)})
+  try{
+   const saved:unknown=await new Promise((ok,fail)=>{const req=db.transaction('keys','readonly').objectStore('keys').get(scope);req.onsuccess=()=>ok(req.result);req.onerror=()=>fail(Error('DEVICE_STORAGE_UNAVAILABLE'))})
+   if(saved!==undefined)return storedDevice(saved)
+   const legacy:unknown=await new Promise((ok,fail)=>{const req=db.transaction('keys','readonly').objectStore('keys').get('primary');req.onsuccess=()=>ok(req.result);req.onerror=()=>fail(Error('DEVICE_STORAGE_UNAVAILABLE'))})
+   const reusable=legacy as Device|undefined
+   const reuse=!!reusable&&legacyIds.includes(reusable.id)&&typeof reusable.publicKey==='string'&&reusable.privateKey instanceof CryptoKey&&reusable.privateKey.type==='private'&&!reusable.privateKey.extractable
+   let value:Device
+   if(reuse)value=storedDevice(reusable)
+   else{
+    const pair=await crypto.subtle.generateKey({name:'Ed25519'},false,['sign','verify']) as CryptoKeyPair
+    const publicBytes=new Uint8Array(await crypto.subtle.exportKey('spki',pair.publicKey))
+    value={id:crypto.randomUUID(),privateKey:pair.privateKey,publicKey:btoa(String.fromCharCode(...publicBytes))}
+   }
+   // Serialize tabs at the existing IndexedDB owner; do not overwrite another
+   // tab's newly enrolled key after generating ours outside the transaction.
+   return await new Promise<Device>((ok,fail)=>{const tx=db.transaction('keys','readwrite'),store=tx.objectStore('keys');let selected=value
+    const read=store.get(scope);read.onsuccess=()=>{try{if(read.result!==undefined)selected=storedDevice(read.result);else store.add(value,scope)}catch{tx.abort()}}
+    tx.oncomplete=()=>ok(selected);tx.onerror=()=>fail(Error('DEVICE_STORAGE_UNAVAILABLE'));tx.onabort=()=>fail(Error('DEVICE_STORAGE_UNAVAILABLE'))})
+  }finally{db.close()}
+ })().catch(error=>{pending.delete(principal);throw error})
+ pending.set(principal,promise);return promise
+}
+export async function operatorIdentity(principal:string,legacyIds:readonly string[]=[]){const value=await device(principal,legacyIds);return {deviceId:value.id,publicKey:value.publicKey}}
+export async function signControl(principal:string,command:Record<string,unknown>,installationId:string){
+ const value=await device(principal),expiresAt=Date.now()+120000,{deliveryAttemptId,...semantic}=command
+ const message=canonical({domain:'agent-control-human-command-v1',installationId,principal,deviceId:value.id,expiresAt,command:semantic})
+ const signature=new Uint8Array(await crypto.subtle.sign('Ed25519',value.privateKey,new TextEncoder().encode(message)))
+ const proof={deviceId:value.id,expiresAt,signature:Array.from(signature,b=>b.toString(16).padStart(2,'0')).join('')}
+ return btoa(JSON.stringify(proof)).replaceAll('+','-').replaceAll('/','_').replace(/=+$/,'')
+}

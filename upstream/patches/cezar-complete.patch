+
+describe('createRun idempotency across ambiguous responses', () => {
+  it('retains the key for retry and persisted browser state, then rotates on success', async () => {
+    setApiScope('proof-retry')
+    const input = { task: 'same intent', workflow: 'quick-task' }
+    fetchMock.mockRejectedValueOnce(new TypeError('connection lost'))
+    await expect(createRun(input)).rejects.toThrow()
+    const first = lastCall().headers.get('Idempotency-Key')
+    expect(first).toBeTruthy()
+    const saved = JSON.parse(sessionStorage.getItem('cezar.pending-create:proof-retry')!)
+    expect(saved.key).toBe(first)
+    // Simulate a persisted browser retry key loaded by another page/module instance.
+    saved.key = 'persisted-reload-key'
+    sessionStorage.setItem('cezar.pending-create:proof-retry', JSON.stringify(saved))
+    reply({ id: 'accepted' })
+    await createRun(input)
+    expect(lastCall().headers.get('Idempotency-Key')).toBe('persisted-reload-key')
+    expect(sessionStorage.getItem('cezar.pending-create:proof-retry')).toBeNull()
+    reply({ id: 'next-accepted' })
+    await createRun(input)
+    expect(lastCall().headers.get('Idempotency-Key')).not.toBe('persisted-reload-key')
+  })
+  it('does not reuse an ambiguous key for a changed payload or another project', async () => {
+    setApiScope('proof-first')
+    fetchMock.mockRejectedValue(new TypeError('connection lost'))
+    await createRun({ task: 'one', workflow: 'quick-task' }).catch(() => {})
+    const first = lastCall().headers.get('Idempotency-Key')
+    await createRun({ task: 'two', workflow: 'quick-task' }).catch(() => {})
+    expect(lastCall().headers.get('Idempotency-Key')).not.toBe(first)
+    setApiScope('proof-second')
+    await createRun({ task: 'one', workflow: 'quick-task' }).catch(() => {})
+    expect(lastCall().headers.get('Idempotency-Key')).not.toBe(first)
+  })
+})
diff --git a/packages/web/src/api/client.ts b/packages/web/src/api/client.ts
--- a/packages/web/src/api/client.ts
+++ b/packages/web/src/api/client.ts
@@ -1555,11 +1555,39 @@
 // ---- run mutations ------------------------------------------------------------------------
 
 /** ×1 answers the run record; ×2/×3 answers `{ runs }` — narrow on `'runs' in result`. */
+const pendingCreateRuns = new Map<string, { body: string; key: string }>()
+
 export async function createRun(input: CreateRunInput): Promise<CreateRunResponse> {
-  return unwrap(
-    await cez.api.v1.p[':projectId'].runs.$post({ param: { projectId: queryScope() }, json: input }),
+  const projectId = queryScope()
+  const storageKey = `cezar.pending-create:${projectId}`
+  const body = JSON.stringify(input)
+  let pending = pendingCreateRuns.get(storageKey)
+  try {
+    const saved = sessionStorage.getItem(storageKey)
+    if (saved) pending = JSON.parse(saved)
+  } catch { /* Storage can be unavailable; retain the in-process retry key. */ }
+  if (!pending || pending.body !== body || typeof pending.key !== 'string') {
+    pending = { body, key: crypto.randomUUID() }
+  }
+  const key = pending.key
+  pendingCreateRuns.set(storageKey, pending)
+  try { sessionStorage.setItem(storageKey, JSON.stringify(pending)) } catch { /* best effort */ }
+  const created = await unwrap(
+    await cez.api.v1.p[':projectId'].runs.$post(
+      { param: { projectId }, json: input },
+      { headers: { 'Idempotency-Key': key } },
+    ),
     '/runs',
   )
+  // An ambiguous failure deliberately retains the key across retry and browser reload.
+  if (pendingCreateRuns.get(storageKey)?.key === key) {
+    pendingCreateRuns.delete(storageKey)
+    try {
+      const saved = sessionStorage.getItem(storageKey)
+      if (saved && JSON.parse(saved).key === key) sessionStorage.removeItem(storageKey)
+    } catch { /* best effort */ }
+  }
+  return created
 }
 

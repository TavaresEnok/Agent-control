+              {folder.git ? <span className="rounded-full bg-muted px-2 py-0.5 text-xs">Git</span> : null}
+              {folder.project ? <span className="rounded-full bg-muted px-2 py-0.5 text-xs">já é projeto</span> : null}
+            </button>
+          </li>
+        ))}
+        {root && folders.length === 0 ? <li className="text-muted-foreground">Nenhuma pasta aqui.</li> : null}
+      </ul>
+      <Button type="button" variant="outline" className="min-h-11 w-fit" disabled={!root || busy} onClick={() => setLabel(folderName)}>Usar esta pasta</Button>
+      <label className="flex flex-col gap-1">Nome
+        <Input aria-label="Nome do projeto" value={label} maxLength={200} onChange={(event) => setLabel(event.target.value)} />
+      </label>
+      <Button type="button" className="min-h-11 w-fit" disabled={!root || !label.trim() || busy} onClick={() => { void create() }}>Criar</Button>
+      {notice ? <p role="status">{notice}</p> : null}
+      {error ? <p role="alert">{error}</p> : null}
+    </div>
+  )
+}
diff --git a/packages/web/src/routes/personal-project-wait.ts b/packages/web/src/routes/personal-project-wait.ts
new file mode 100644
index 0000000000000000000000000000000000000000..951245103833bc92e05df09970756be03bb19d32
--- /dev/null
+++ b/packages/web/src/routes/personal-project-wait.ts
@@ -0,0 +1,29 @@
+import { z } from 'zod'
+
+import { agentControlFetch } from './settings/agent-control-fetch'
+
+const projectsSchema = z.object({
+  projects: z.array(z.object({ id: z.string() })),
+  primaryProjectId: z.string().optional(),
+})
+
+export async function readPersonalProjects() {
+  const response = await agentControlFetch('/api/v1/ac/projects', { cache: 'no-store' })
+  if (!response.ok) throw new Error('PROJECTS_UNAVAILABLE')
+  return projectsSchema.parse(await response.json())
+}
+
+/** Polls until the project is present or gone. Gives the gateway time to restart. */
+export async function waitForPersonalProject(projectId: string, present: boolean) {
+  const deadline = Date.now() + 60_000
+  while (Date.now() < deadline) {
+    try {
+      const page = await readPersonalProjects()
+      if (page.projects.some((project) => project.id === projectId) === present) return true
+    } catch {
+      // The gateway may be down while systemd starts it again.
+    }
+    await new Promise((resolve) => setTimeout(resolve, 2000))
+  }
+  return false
+}

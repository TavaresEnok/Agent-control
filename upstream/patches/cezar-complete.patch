+function reasonText(status:keyof typeof STATUS_LABEL,reason:string){
+ if(status==='unknown')return UNKNOWN_REASON[reason]??`Motivo não catalogado nesta tela: ${reason}. Desconhecido não é cumprimento do objetivo.`
